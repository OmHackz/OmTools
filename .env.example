# OmTools environment variables
# Copy to .env for local development. Never commit real keys.

# --- AI proxy (server-side only) -------------------------------------------
# Any OpenAI-compatible API: OpenAI, Groq, Together, OpenRouter, local Ollama, ...
AI_API_KEY=
# Default: https://api.openai.com/v1
AI_BASE_URL=https://api.openai.com/v1
# Default: gpt-4o-mini
AI_MODEL=gpt-4o-mini

# --- Analytics --------------------------------------------------------------
# Umami script URL, e.g. https://analytics.omhackz.top/script.js
VITE_UMAMI_SCRIPT_URL=
